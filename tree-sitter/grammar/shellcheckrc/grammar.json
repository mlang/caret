{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "shellcheckrc",
  "rules": {
    "shellcheckrc_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_directive"
      }
    },
    "_directive": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "disable_directive"
        },
        {
          "type": "SYMBOL",
          "name": "enable_directive"
        },
        {
          "type": "SYMBOL",
          "name": "extended_analysis_directive"
        },
        {
          "type": "SYMBOL",
          "name": "external_sources_directive"
        },
        {
          "type": "SYMBOL",
          "name": "source_directive"
        },
        {
          "type": "SYMBOL",
          "name": "source_path_directive"
        },
        {
          "type": "SYMBOL",
          "name": "shell_directive"
        }
      ]
    },
    "_disable_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "all"
        },
        {
          "type": "SYMBOL",
          "name": "_rule_id_list"
        }
      ]
    },
    "disable_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "disable"
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "STRING",
            "value": "="
          }
        },
        {
          "type": "SYMBOL",
          "name": "_disable_value"
        }
      ]
    },
    "enable_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "enable"
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "STRING",
            "value": "="
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "all"
            },
            {
              "type": "SYMBOL",
              "name": "identifier"
            }
          ]
        }
      ]
    },
    "extended_analysis_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "extended-analysis"
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "STRING",
            "value": "="
          }
        },
        {
          "type": "SYMBOL",
          "name": "boolean"
        }
      ]
    },
    "external_sources_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "external-sources"
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "STRING",
            "value": "="
          }
        },
        {
          "type": "SYMBOL",
          "name": "boolean"
        }
      ]
    },
    "_source_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        }
      ]
    },
    "source_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "source"
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "STRING",
            "value": "="
          }
        },
        {
          "type": "SYMBOL",
          "name": "_source_value"
        }
      ]
    },
    "source_path_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "source-path"
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "STRING",
            "value": "="
          }
        },
        {
          "type": "SYMBOL",
          "name": "_source_value"
        }
      ]
    },
    "shell_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "shell"
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "STRING",
            "value": "="
          }
        },
        {
          "type": "SYMBOL",
          "name": "shell"
        }
      ]
    },
    "all": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 5,
        "content": {
          "type": "STRING",
          "value": "all"
        }
      }
    },
    "SCRIPTDIR": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 5,
        "content": {
          "type": "STRING",
          "value": "SCRIPTDIR"
        }
      }
    },
    "shell": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "sh"
        },
        {
          "type": "STRING",
          "value": "bash"
        },
        {
          "type": "STRING",
          "value": "dash"
        },
        {
          "type": "STRING",
          "value": "ksh"
        },
        {
          "type": "STRING",
          "value": "busybox"
        }
      ]
    },
    "rule_id": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "IMMEDIATE_TOKEN",
              "content": {
                "type": "STRING",
                "value": "SC"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "id",
          "content": {
            "type": "SYMBOL",
            "name": "integer"
          }
        }
      ]
    },
    "_rule_id": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "rule_id"
        },
        {
          "type": "SYMBOL",
          "name": "rule_id_range"
        }
      ]
    },
    "_rule_id_list": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_rule_id"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "IMMEDIATE_TOKEN",
                "content": {
                  "type": "STRING",
                  "value": ","
                }
              },
              {
                "type": "SYMBOL",
                "name": "_rule_id"
              }
            ]
          }
        }
      ]
    },
    "rule_id_range": {
      "type": "PREC",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "from",
            "content": {
              "type": "SYMBOL",
              "name": "rule_id"
            }
          },
          {
            "type": "IMMEDIATE_TOKEN",
            "content": {
              "type": "STRING",
              "value": "-"
            }
          },
          {
            "type": "FIELD",
            "name": "to",
            "content": {
              "type": "SYMBOL",
              "name": "rule_id"
            }
          }
        ]
      }
    },
    "integer": {
      "type": "PATTERN",
      "value": "[0-9]+"
    },
    "boolean": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "true"
        },
        {
          "type": "STRING",
          "value": "false"
        }
      ]
    },
    "string": {
      "type": "PREC",
      "value": 1,
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "'"
              },
              {
                "type": "PATTERN",
                "value": "[^']*"
              },
              {
                "type": "STRING",
                "value": "'"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "\""
              },
              {
                "type": "PATTERN",
                "value": "[^\"]*"
              },
              {
                "type": "STRING",
                "value": "\""
              }
            ]
          }
        ]
      }
    },
    "identifier": {
      "type": "PREC",
      "value": -9,
      "content": {
        "type": "PATTERN",
        "value": "[a-zA-Z0-9-_./]+"
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "#"
          },
          {
            "type": "PATTERN",
            "value": ".*"
          }
        ]
      }
    },
    "_whitespace": {
      "type": "PATTERN",
      "value": "[ \\t\\r\\n]+"
    }
  },
  "extras": [
    {
      "type": "SYMBOL",
      "name": "_whitespace"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}