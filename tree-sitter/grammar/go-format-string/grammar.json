{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "go_format_string",
  "rules": {
    "format_string": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "text"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_maybe_format"
              },
              {
                "type": "SYMBOL",
                "name": "text"
              }
            ]
          }
        }
      ]
    },
    "_maybe_format": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "escaped_percent_sign"
        },
        {
          "type": "SYMBOL",
          "name": "format_specifier"
        }
      ]
    },
    "format_specifier": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "%"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "flag"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "explicit_argument_index_expr"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_width_and_precision"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "verb"
        }
      ]
    },
    "explicit_argument_index": {
      "type": "PATTERN",
      "value": "[0-9]+"
    },
    "explicit_argument_index_expr": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "SYMBOL",
          "name": "explicit_argument_index"
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "asterisk": {
      "type": "STRING",
      "value": "*"
    },
    "width": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "asterisk"
        },
        {
          "type": "PATTERN",
          "value": "[0-9]+"
        }
      ]
    },
    "precision": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "asterisk"
        },
        {
          "type": "PATTERN",
          "value": "[0-9]*"
        }
      ]
    },
    "_width_and_precision": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "width"
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "STRING",
                  "value": "."
                },
                {
                  "type": "BLANK"
                }
              ]
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "precision"
                },
                {
                  "type": "BLANK"
                }
              ]
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "."
            },
            {
              "type": "SYMBOL",
              "name": "precision"
            }
          ]
        }
      ]
    },
    "verb": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "v"
        },
        {
          "type": "STRING",
          "value": "T"
        },
        {
          "type": "STRING",
          "value": "t"
        },
        {
          "type": "STRING",
          "value": "b"
        },
        {
          "type": "STRING",
          "value": "c"
        },
        {
          "type": "STRING",
          "value": "d"
        },
        {
          "type": "STRING",
          "value": "e"
        },
        {
          "type": "STRING",
          "value": "E"
        },
        {
          "type": "STRING",
          "value": "f"
        },
        {
          "type": "STRING",
          "value": "F"
        },
        {
          "type": "STRING",
          "value": "g"
        },
        {
          "type": "STRING",
          "value": "G"
        },
        {
          "type": "STRING",
          "value": "o"
        },
        {
          "type": "STRING",
          "value": "O"
        },
        {
          "type": "STRING",
          "value": "q"
        },
        {
          "type": "STRING",
          "value": "x"
        },
        {
          "type": "STRING",
          "value": "X"
        },
        {
          "type": "STRING",
          "value": "U"
        },
        {
          "type": "STRING",
          "value": "s"
        },
        {
          "type": "STRING",
          "value": "p"
        },
        {
          "type": "STRING",
          "value": "w"
        }
      ]
    },
    "escaped_percent_sign": {
      "type": "STRING",
      "value": "%%"
    },
    "flag": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "+"
        },
        {
          "type": "STRING",
          "value": "-"
        },
        {
          "type": "STRING",
          "value": "#"
        },
        {
          "type": "STRING",
          "value": " "
        },
        {
          "type": "STRING",
          "value": "0"
        }
      ]
    },
    "text": {
      "type": "PATTERN",
      "value": "[^%]*"
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}