{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "lua_format_string",
  "rules": {
    "format_string": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "text"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_maybe_format"
              },
              {
                "type": "SYMBOL",
                "name": "text"
              }
            ]
          }
        }
      ]
    },
    "_maybe_format": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "escaped_percent_sign"
        },
        {
          "type": "SYMBOL",
          "name": "directive"
        }
      ]
    },
    "directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "%"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "flag"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_width_and_precision"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "conversion_specifier"
        }
      ]
    },
    "width": {
      "type": "PATTERN",
      "value": "([0-9]|[1-9][0-9])"
    },
    "precision": {
      "type": "PATTERN",
      "value": "([0-9]|[1-9][0-9])"
    },
    "_width_and_precision": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "width"
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "STRING",
                  "value": "."
                },
                {
                  "type": "BLANK"
                }
              ]
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "precision"
                },
                {
                  "type": "BLANK"
                }
              ]
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "."
            },
            {
              "type": "SYMBOL",
              "name": "precision"
            }
          ]
        }
      ]
    },
    "conversion_specifier": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "a"
        },
        {
          "type": "STRING",
          "value": "A"
        },
        {
          "type": "STRING",
          "value": "b"
        },
        {
          "type": "STRING",
          "value": "B"
        },
        {
          "type": "STRING",
          "value": "c"
        },
        {
          "type": "STRING",
          "value": "d"
        },
        {
          "type": "STRING",
          "value": "e"
        },
        {
          "type": "STRING",
          "value": "E"
        },
        {
          "type": "STRING",
          "value": "f"
        },
        {
          "type": "STRING",
          "value": "g"
        },
        {
          "type": "STRING",
          "value": "G"
        },
        {
          "type": "STRING",
          "value": "i"
        },
        {
          "type": "STRING",
          "value": "o"
        },
        {
          "type": "STRING",
          "value": "u"
        },
        {
          "type": "STRING",
          "value": "p"
        },
        {
          "type": "STRING",
          "value": "q"
        },
        {
          "type": "STRING",
          "value": "s"
        },
        {
          "type": "STRING",
          "value": "u"
        },
        {
          "type": "STRING",
          "value": "x"
        },
        {
          "type": "STRING",
          "value": "X"
        }
      ]
    },
    "escaped_percent_sign": {
      "type": "STRING",
      "value": "%%"
    },
    "flag": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "+"
        },
        {
          "type": "STRING",
          "value": "-"
        },
        {
          "type": "STRING",
          "value": "#"
        },
        {
          "type": "STRING",
          "value": " "
        },
        {
          "type": "STRING",
          "value": "0"
        }
      ]
    },
    "text": {
      "type": "PATTERN",
      "value": "[^%]*"
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}